   "source": [
    "def quality_report(df,name):\n",
    "    print(f\"{name}: shape={df.shape}; duplikat={df.duplicated().sum()}\")\n",
    "    q=pd.DataFrame({\"dtype\":df.dtypes.astype(str),\"missing\":df.isna().sum(),\"missing_%\":(df.isna().mean()*100).round(2),\"unique\":df.nunique()})\n",
    "    display(q)\n",
    "quality_report(train_raw,\"train\")\n",
    "quality_report(center_info,\"fulfilment_center_info\")\n",
    "quality_report(meal_info,\"meal_info\")\n",
    "print(\"Rentang minggu:\",train_raw.week.min(),\"-\",train_raw.week.max())\n",
    "print(\"Pusat:\",train_raw.center_id.nunique(),\"| Makanan:\",train_raw.meal_id.nunique())\n",
    "display(train_raw.num_orders.describe(percentiles=[.5,.75,.9,.95,.99,.999]).to_frame())"
   ]
  },
