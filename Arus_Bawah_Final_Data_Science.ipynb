    "import warnings, os\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "from pathlib import Path\n",
    "import numpy as np, pandas as pd, matplotlib.pyplot as plt, seaborn as sns\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.linear_model import LinearRegression, Ridge\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.dummy import DummyRegressor\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "import joblib\n",
    "RANDOM_STATE=42\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "pd.set_option(\"display.max_columns\", 100)\n",
    "\n",
    "def find_csv(name):\n",
    "    for p in [Path(\"data\")/name, Path(name), Path(\"/mnt/data/files\")/name]:\n",
    "        if p.exists(): return p\n",
    "    raise FileNotFoundError(f\"{name} tidak ditemukan. Simpan CSV di folder data/.\")\n",
    "train_raw=pd.read_csv(find_csv(\"train.csv\"))\n",
    "center_info=pd.read_csv(find_csv(\"fulfilment_center_info.csv\"))\n",
    "meal_info=pd.read_csv(find_csv(\"meal_info.csv\"))\n",
    "print(\"Train:\",train_raw.shape,\"| Center:\",center_info.shape,\"| Meal:\",meal_info.shape)"
   ]
