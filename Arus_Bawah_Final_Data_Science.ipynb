   "source": [
    "from sklearn.preprocessing import OrdinalEncoder\n",
    "\n",
    "# Preprocessing untuk model linear: scaling + one-hot\n",
    "numeric_pipe=Pipeline([(\"imputer\",SimpleImputer(strategy=\"median\")),(\"scale\",StandardScaler())])\n",
    "category_pipe=Pipeline([(\"imputer\",SimpleImputer(strategy=\"most_frequent\")),(\"onehot\",OneHotEncoder(handle_unknown=\"ignore\"))])\n",
    "preprocess=ColumnTransformer([(\"num\",numeric_pipe,num_features),(\"cat\",category_pipe,cat_features)])\n",
    "\n",
    "# Preprocessing untuk Random Forest: ordinal encoding (dense, hanya 17 kolom).\n",
    "# One-hot (218 kolom sparse) membuat Random Forest sangat lambat dan boros RAM sehingga kernel mati.\n",
    "rf_numeric=Pipeline([(\"imputer\",SimpleImputer(strategy=\"median\"))])\n",
    "rf_category=Pipeline([(\"imputer\",SimpleImputer(strategy=\"most_frequent\")),\n",
    "                      (\"ordinal\",OrdinalEncoder(handle_unknown=\"use_encoded_value\",unknown_value=-1))])\n",
    "preprocess_rf=ColumnTransformer([(\"num\",rf_numeric,num_features),(\"cat\",rf_category,cat_features)])\n",
    "\n",
    "pipelines={\n",
    " \"Linear Regression\":Pipeline([(\"preprocess\",preprocess),(\"model\",LinearRegression())]),\n",
    " \"Ridge Regression\":Pipeline([(\"preprocess\",preprocess),(\"model\",Ridge(alpha=1.0))]),\n",
    " \"Random Forest\":Pipeline([(\"preprocess\",preprocess_rf),(\"model\",RandomForestRegressor(\n",
    "        n_estimators=60,min_samples_leaf=5,max_features=0.5,max_samples=0.5,\n",
    "        random_state=RANDOM_STATE,n_jobs=-1))]),\n",
    "}\n",
    "def metrics(y,p):\n",
    "    return {\"MAE\":mean_absolute_error(y,p),\"RMSE\":np.sqrt(mean_squared_error(y,p)),\"R2\":r2_score(y,p)}\n",
    "# Baseline pembanding: prediksi rata-rata target pada train\n",
    "baseline=DummyRegressor(strategy=\"mean\").fit(np.zeros((len(y_train),1)),y_train)\n",
    "baseline_pred=baseline.predict(np.zeros((len(y_test),1)))\n",
    "results={\"Baseline mean\":metrics(y_test,baseline_pred)}\n",
    "predictions={}\n",
    "for name,pipe in pipelines.items():\n",
    "    print(\"Training\",name)\n",
    "    pipe.fit(X_train,y_train)\n",
    "    predictions[name]=pipe.predict(X_test)\n",
    "    results[name]=metrics(y_test,predictions[name])\n",
    "results_df=pd.DataFrame(results).T.sort_values(\"RMSE\")\n",
    "display(results_df)"
   ]
  },
