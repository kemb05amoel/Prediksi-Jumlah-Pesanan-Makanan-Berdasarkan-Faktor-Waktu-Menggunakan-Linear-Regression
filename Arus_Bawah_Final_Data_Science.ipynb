   "source": [
    "train=train_raw.drop_duplicates().copy()\n",
    "centers=center_info.drop_duplicates(subset=\"center_id\").copy()\n",
    "meals=meal_info.drop_duplicates(subset=\"meal_id\").copy()\n",
    "for col in [\"week\",\"center_id\",\"meal_id\",\"checkout_price\",\"base_price\",\"emailer_for_promotion\",\"homepage_featured\",\"num_orders\"]:\n",
    "    train[col]=pd.to_numeric(train[col],errors=\"coerce\")\n",
    "centers[\"op_area\"]=pd.to_numeric(centers[\"op_area\"],errors=\"coerce\")\n",
    "data=train.merge(centers,on=\"center_id\",how=\"left\",validate=\"many_to_one\")\n",
    "data=data.merge(meals,on=\"meal_id\",how=\"left\",validate=\"many_to_one\")\n",
    "print(\"Ukuran setelah join:\",data.shape)\n",
    "display(data.head())\n",
    "display(data.isna().sum().sort_values(ascending=False).to_frame(\"missing\"))"
   ]
